# Launchpad STAGING env contract — spec 0132. Install as /etc/launchpad/staging.env
# on 203.0.113.20, 0640 root:root, and NEVER commit the filled-in copy.
#
# Every value here is staging's OWN. Copying production's would defeat the point:
# a shared AUTH_SECRET makes a staging session a production session, and a shared
# master key means production's encrypted secrets are decryptable on the box where
# mistakes are supposed to be cheap.

# --- routing (spec 0132 D needs the DNS record before TLS can be issued) --------
# staging.launchpad.example.com. A 203.0.113.20
LAUNCHPAD_STAGING_WEB_HOST=staging.launchpad.example.com
# Traefik's existing docker network on that box — `docker network ls` to confirm the
# real name before first deploy; it is the network its own compose project created.
LAUNCHPAD_TRAEFIK_NETWORK=traefik_default

# --- staging's own control plane -----------------------------------------------
# Generate on the box, never reuse production's:
#   head -c 400 /dev/urandom | tr -dc 'A-Za-z0-9' | cut -c1-32
# (NOT `tr … | head -c 32` — under pipefail that dies of SIGPIPE, docs/VERIFICATION.md #8.)
LAUNCHPAD_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=
DATABASE_URL=postgres://launchpad:CHANGEME@launchpad-db:5432/launchpad
TEMPORAL_ADDRESS=temporal:7233

# --- auth (its own, deliberately) ----------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
# The GitHub OAuth app needs staging's callback URL registered as well:
#   https://staging.launchpad.example.com/api/auth/callback/github
# Same app is fine (multiple callback URLs are allowed); a separate app is cleaner.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_URL=https://staging.launchpad.example.com

# base64 of 32 random bytes: openssl rand -base64 32
LAUNCHPAD_SECRET_MASTER_KEY=

# --- the repository this environment works in -----------------------------------
# Inside the container. The image carries the `staging` branch's tree.
LAUNCHPAD_REPO_ROOT=/app

# SPEC 0132 DECISION 3 — READ THIS BEFORE FILLING IT IN.
#
# Staging runs the same pipeline code as production, and a pipeline run pushes
# branches and opens PRs. A push-capable token here is a second machine that can
# write to example-org/launchpad from the environment whose purpose is that
# mistakes are cheap.
#
# So: leave this EMPTY, or use a token with READ-ONLY access. A code run on staging
# is then expected to fail at push, loudly. That is the correct behaviour for an
# environment meant for exercising the UI and the flow.
GITHUB_TOKEN=

# --- optional, off by default ---------------------------------------------------
# Agent sessions need this; staging can run the UI and the gates without it, and a
# spawned session with no token fails visibly rather than silently doing nothing.
CLAUDE_CODE_OAUTH_TOKEN=
# The supervisor console's Bash policy is a deny-list, not a sandbox (CLAUDE.md).
# Leave it OFF on staging unless you are specifically testing that surface.
# SUPERVISOR_CONSOLE_ENABLED=

# Fleet operations are NOT enabled here: this box IS the fleet's staging host, and
# ADR-013 allows destructive fleet calls only against infra/fleet-sandbox.json ids.
# Leaving HOSTINGER_API_TOKEN unset keeps staging out of that blast radius.
# HOSTINGER_API_TOKEN=

# --- seeding the first user -----------------------------------------------------
# `pnpm --filter @launchpad/db seed-owner` reads these. Staging's OWNER is whoever
# needs to sign in there; the password is scrypt-hashed at seed time.
LAUNCHPAD_OWNER_EMAIL=owner@example.com
LAUNCHPAD_OWNER_NAME=Owner
LAUNCHPAD_OWNER_PASSWORD=
