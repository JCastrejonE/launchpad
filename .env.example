# Launchpad VPS — dev bootstrap only. In production all of these live in Vault.

# Vault (dev)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-only-token

# Temporal (dev)
TEMPORAL_ADDRESS=localhost:7233

# Launchpad DB
DATABASE_URL=postgres://launchpad:launchpad@localhost:5433/launchpad

# Master key for the encrypted control-plane secret store (spec 0076) —
# base64 of 32 random bytes; the env holds this ONE key instead of many
# secrets. Consumed by the worker + fleet scripts to decrypt `secrets` rows
# (e.g. tenant DB passwords). NOT on the agent-session env allowlist, so
# spawned agents never see it. Generate: `openssl rand -base64 32`
LAUNCHPAD_SECRET_MASTER_KEY=

# Control-plane owner seed (spec 0072) — consumed ONLY by
# `pnpm --filter @launchpad/db seed-owner` (env, not argv, so the password
# never lands in `ps`/shell history; it is scrypt-hashed immediately and never
# stored). Leave blank here; export them in the shell that runs the seed.
LAUNCHPAD_OWNER_EMAIL=
LAUNCHPAD_OWNER_NAME=
LAUNCHPAD_OWNER_PASSWORD=

# Hostinger — VPS provisioning (exclusive infra provider for client VPSes)
HOSTINGER_API_TOKEN=

# Fleet SSH — path to the private key for automated fleet ops: tenant deploys
# (deployToProduction) AND the /fleet live tenant/DB inventory (spec 0033).
# preflight sources this file with `set -a`, so BOTH the worker and apps/web
# inherit it — the web server needs it too, else the /fleet sandbox card
# degrades to "live inventory unavailable". Path only — never the key material
# (the key lives outside the repo, e.g. ~/.ssh/fleet_key).
LAUNCHPAD_FLEET_SSH_IDENTITY=
# SSH user for fleet ops (optional; the fleet layer defaults to "root").
LAUNCHPAD_FLEET_SSH_USER=root

# Domain a per-spec staging host is built from (spec 0119), as
# `spec-<id>.<tenant>.<this>`. Optional: defaults to the tenant deploy domain
# `sandbox.launchpad.test`, which is an RFC 6761 reserved TLD and can NEVER
# resolve publicly — every tenant to date was verified by an SSH-side curl with a
# `Host:` header, which is why nobody noticed.
#
# A free wildcard-DNS service unblocks a resolvable name with no registrar change
# and no naming decision, because it resolves any name containing an embedded IP:
#   LAUNCHPAD_STAGING_DOMAIN=203.0.113.20.sslip.io
#   -> spec-0120.sandbox.203.0.113.20.sslip.io resolves to 203.0.113.20
# It is NOT a path to a valid certificate: sslip.io is not on the Public Suffix
# List, so Let's Encrypt rate-limits it across every user of that domain. Swap for
# `*.staging.<our-domain>` once that is decided — this var is why that needs no
# code change.
#
# NOTE (spec 0120): a resolvable name is only half of a working URL. The tenant
# template's Traefik router currently has no TLS config, so every tenant host 404s
# through the ingress regardless of DNS.
LAUNCHPAD_STAGING_DOMAIN=

# Domain TENANT hosts are built from, as `<stack>.<tenant>.<this>` (spec 0121).
# Same seam as the staging one above and for the same reason: the default
# `sandbox.launchpad.test` cannot resolve, so without this the only way into a
# tenant is an /etc/hosts entry. Changing it rewrites every Traefik router rule,
# so each tenant needs one redeploy to pick it up.
LAUNCHPAD_TENANT_DOMAIN=

# Odoo credentials (spec 0121). TWO DIFFERENT PASSWORDS — conflating them is how
# people lock themselves out:
#   MASTER governs /web/database/manager, i.e. create/drop/duplicate/backup of the
#     tenant's database. The image ships `; admin_passwd = admin` COMMENTED OUT, so
#     without this Odoo's default governs a host we expose on purpose.
#   ADMIN is the `admin` login typed at /web/login.
# Both are REQUIRED for any tenant or staging deploy — it fails fast rather than
# silently running on defaults. Applied on every deploy, which is also how an
# existing tenant's login password gets corrected.
# Allowed charset is [A-Za-z0-9_@%+=:,./-], 8-128 chars: both are interpolated into
# a remote shell command and one into a Python literal.
LAUNCHPAD_ODOO_MASTER_PASSWORD=
LAUNCHPAD_ODOO_ADMIN_PASSWORD=

# GitHub App (clients connect their account; app credentials are ours)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Owner agent credential (Claude Team plan). Generate: `claude setup-token`
# Client credentials are NEVER put here — they live in Vault tenants/<id>/
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub OAuth (spec 0128) — Auth.js v5 auto-detects AUTH_<PROVIDER>_ID/_SECRET.
# The OAuth app's Authorization callback URL must be exactly
#   https://<your-host>/api/auth/callback/github
# The ID is public (it appears in the redirect); the SECRET is not — set it on the
# host, never through a chat or a commit. Scope: the narrowest that answers
# `permissions.push` on a private repo, since this token only ever answers "may
# this person write to this repo?" (the merge uses the promoter's own token, and
# pushes/PR-opens keep using GITHUB_TOKEN — spec 0128 decision 5).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# apps/web — signs the Auth.js session JWT (spec 0073). Required by the
# strict web-env check. Generate one: `openssl rand -base64 32`
# (GATE_ACTOR_EMAIL is gone since spec 0074 — the actor on every gate/deploy
# action is the signed-in OWNER's session email.)
AUTH_SECRET=

# apps/web / packages/pipeline CLI — absolute path of this repo checkout,
# used as the "launchpad" pipeline target's repo. Required by
# startPipeline()/the CLI's `start` command and by the worker's markSpec.
# `scripts/preflight.sh` sets this automatically (defaults to the repo root),
# so the SUPPORTED way to start the app — `bash scripts/preflight.sh` — never
# needs it here. Set it ONLY if you start apps/web WITHOUT preflight (e.g. a
# bare `next dev`); a blank value fails the strict web-env check (spec 0007)
# and the app reports {"ok":false,"checks":{"env":false}} on /api/health.
LAUNCHPAD_REPO_ROOT=

# Backups (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=launchpad-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=
